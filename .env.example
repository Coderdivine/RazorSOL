PORT=2004
NODE_ENV=development

JWT_SECRET=
MONGO_ATLAS_URI=
SCHEDULE_SECRET="hash"
BCRYPT_SALT=

LANDING_URL=
DASHBOARD_URL=

MAILER_HOST=
MAILER_USER=
MAILER_PASSWORD=
MAILER_PORT=
MAILER_SECURE=

# Razor Trading Bot Variables
WALLET_PUBLIC_KEY=
WALLET_PRIVATE_KEY=
PUMPPORTAL_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERTS_CHANNEL=

# Telegram user IDs allowed to control the bot, comma separated. STRONGLY recommended.
# Without it the bot locks to the admin chat already on record.
TELEGRAM_ADMIN_IDS=

# ONE keyed RPC for everything (reads, websocket, confirmations). A free Helius,
# QuickNode or Alchemy key is enough. The shared public endpoint is rate limited
# and causes missed signals and unconfirmed trades.
SOLANA_RPC_URL=
# Optional. Derived from SOLANA_RPC_URL when empty.
SOLANA_WSS_URL=
# Optional second BROADCASTER only. Never used for reads or polling.
INFURA_API_KEY=
INFURA_SOLANA_RPC_URL=
# Optional. Raises the Jupiter price API rate limit.
JUPITER_API_KEY=

# paper = simulated fills, no funds move (default). live = real funds.
TRADING_MODE=paper

# Sizing (live and paper)
TRADE_FRACTION=0.25      # share of balance per trade (max 0.7)
MIN_TRADE_SOL=0.05       # skip trades smaller than this, fixed costs eat them
MAX_TRADE_SOL=0          # 0 = no cap
RESERVE_SOL=0.01         # always kept in the wallet to pay for exits

# Execution
BUY_SLIPPAGE_PCT=20
SELL_SLIPPAGE_PCT=40
CLOSE_TOKEN_ACCOUNTS=true   # reclaim the ~0.002 SOL deposit after a full exit

# Paper trading model
PAPER_START_SOL=1
PAPER_SLIPPAGE_PCT=5     # extra slippage assumed on top of the live quote
PAPER_FEE_PCT=1.5        # venue fee + PumpPortal fee, per side
